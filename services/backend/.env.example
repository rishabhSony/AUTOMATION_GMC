# Copy to services/backend/.env.backend.local (gitignored). Variable names from TRD §12.
ENVIRONMENT=development

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=../../storage
GMC_S3_BUCKET_NAME=gmc-quote-automation-prod
AWS_REGION=ap-south-1

DATABASE_URL=postgresql://quotepulse_app:dev_password_123@localhost:5432/quotepulse_dev?sslmode=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Live Clerk mode: JWKS URL of the Clerk instance (and optionally the issuer).
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Empty key in development → mock AI; in production → 503.
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTION=gpt-5.4-mini
OPENAI_MODEL_VERIFICATION=gpt-5.4-mini
OPENAI_ZERO_DATA_RETENTION=true
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

PARSER_PDF_ENGINE=pymupdf

# Offline dev modes (development only)
ENABLE_DEV_MOCK_AUTH=true
USE_MOCK_AI=true
