# Variables for `docker compose` (copy to .env next to docker-compose.yml; never commit .env).
# The apps' own local-dev env files are apps/web/.env.example and
# services/backend/.env.example; names below match those (TRD §12).

# --- Public origins ------------------------------------------------------------
# Browser-facing URLs. NEXT_PUBLIC_API_URL is baked into the web image at build time.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
WEB_PORT=3000
API_PORT=8000

# --- PostgreSQL 16 (container `db`) -------------------------------------------
# Use URL-safe passwords (letters, digits, - _ .): they are embedded in DATABASE_URL.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
APP_DB_PASSWORD=change-me-app
POSTGRES_DB=quotepulse

# --- Redis 7 (container `redis`) ------------------------------------------------
REDIS_PASSWORD=change-me-redis

# --- Clerk -----------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_JWKS_URL=
CLERK_ISSUER=

# --- OpenAI (gpt-5.4-mini) ------------------------------------------------------
# Production never falls back to mock AI: without a key, extraction returns 503.
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTION=gpt-5.4-mini
OPENAI_MODEL_VERIFICATION=gpt-5.4-mini
OPENAI_ZERO_DATA_RETENTION=true

# --- Storage ---------------------------------------------------------------------
# local: ./storage/inputs and ./storage/outputs are mounted into the API container.
# s3: set the bucket; the API needs AWS credentials (instance role on EC2).
STORAGE_BACKEND=local
GMC_S3_BUCKET_NAME=gmc-quote-automation-prod
AWS_REGION=ap-south-1

# --- Corporate forward proxy (EC2 egress; TRD §6) --------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,redis,backend,web
