.DS_Store

# Env files
.env
.env.*
!.env.example

# JS build artifacts (also in apps/web/.gitignore; repeated so any workspace is covered)
node_modules/
.next/
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# Local storage: keep the folder tree, ignore case files
storage/**
!storage/**/
!storage/**/.gitkeep
