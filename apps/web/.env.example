# Copy to apps/web/.env.local (gitignored). Variable names from TRD §12.
ENVIRONMENT=development
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://quotepulse_app:dev_password_123@localhost:5432/quotepulse_dev?sslmode=disable"
DATABASE_POOL_SIZE=10

# Live Clerk mode: fill these and set NEXT_PUBLIC_ENABLE_DEV_MOCK_AUTH=false.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/invite/accept
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Offline mock mode (no Clerk): only honoured by `bun run dev`, never by a production build.
# The API must run with ENVIRONMENT=development and ENABLE_DEV_MOCK_AUTH=true.
NEXT_PUBLIC_ENABLE_DEV_MOCK_AUTH=true
